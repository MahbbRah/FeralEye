# Camera Guard Configuration

# Location / Camera Info
CAMERA_NAME=Poultry Pen
CAMERA_RTSP_URL=rtsp://192.168.1.233/live/ch00_0
STREAM_BACKEND=opencv
CAMERA_CONNECT_TIMEOUT_SEC=10.0
CAMERA_RECONNECT_INITIAL_DELAY_SEC=2.0
CAMERA_RECONNECT_MAX_DELAY_SEC=30.0

# Detection Settings
DETECTION_FPS=1.0
MODEL_NAME=yolo11s.pt
TARGET_CLASSES=["cat", "dog", "person"]
CONFIDENCE_THRESHOLD=0.25
INFERENCE_IMAGE_SIZE=640

# Motion Filtering (Optional pre-filter)
ENABLE_MOTION_FILTER=false
MOTION_MIN_AREA=500
MOTION_THRESHOLD=25

# Confirmation & Cooldown Strategy
CONFIRMATION_COUNT=2
CONFIRMATION_WINDOW_SEC=4.0
ALERT_COOLDOWN_SEC=180.0

# Evidence Storage & 20s Event Video Recording
EVIDENCE_DIRECTORY=./evidence_storage
SAVE_ANNOTATED_IMAGE=true
SAVE_RAW_IMAGE=false
RECORD_EVENT_VIDEO=true
VIDEO_PRE_BUFFER_SEC=10.0
VIDEO_POST_BUFFER_SEC=10.0
VIDEO_CLIP_FPS=10.0

# ============================================================
# CLOUD SYNC (Google Drive)
# ============================================================
GDRIVE_SYNC_ENABLED=false
GDRIVE_SERVICE_ACCOUNT_JSON=./gdrive_credentials.json
GDRIVE_FOLDER_ID=your_gdrive_folder_id_here
GDRIVE_UPLOAD_VIDEOS=true
GDRIVE_UPLOAD_PHOTOS=true

# ============================================================
# ALERT INTEGRATIONS (Enable any combination)
# ============================================================

# 1. Telegram Bot Alert (Instant Photo & Push Notification)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2. Ntfy.sh Smartphone Push Alarms (Free, Open-Source App)
NTFY_ENABLED=false
NTFY_TOPIC=my_poultry_guard_alerts_12345
NTFY_SERVER_URL=https://ntfy.sh
NTFY_PRIORITY=urgent

# 3. Discord Channel Webhook
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=

# 4. SMTP Email with Photo Attachment
EMAIL_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_SENDER=myemail@gmail.com
EMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_RECIPIENTS=["myemail@gmail.com"]
EMAIL_USE_TLS=true

# 5. Generic Webhook (Home Assistant / MQTT bridge)
WEBHOOK_ENABLED=false
WEBHOOK_URL=http://homeassistant.local:8123/api/webhook/predator_detected

# 6. Local Speaker Audio Alarm (Plays siren on Mac/Phone speaker)
AUDIO_ALARM_ENABLED=false
AUDIO_ALARM_FILE=

# Logging & Telemetry
LOG_LEVEL=INFO
LOG_FILE=./logs/camera_guard.log
METRICS_LOG_INTERVAL_SEC=60.0
